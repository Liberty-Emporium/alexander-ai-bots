# ---------------------------------------------------------------------------
# Alexander AI Solutions Bots Platform - deployment environment
#
# Copy this to .env in your deployment folder and fill in the two keys.
# Generate KEY_ENCRYPTION_KEY with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

# The app itself
EMBEDDED_POSTGRES=on
PORT=3001
KEY_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# One administrator, no sign-in inside the app (the login gate sits in front
# of it, see deploy/Caddyfile.example). Set false once you configure an
# identity provider and want real sign-in.
OPENBOT_SINGLE_USER=true

# Where the bots and channels come from
TENANT_PACKAGE_DIR=/tenant
DEPLOYMENT_ID=my-bots

# The bot's computer: headed Chromium on a virtual display is the stable,
# least-detectable configuration. IDLE_MS=0 keeps the browser resident.
COMPUTER_SANDBOX=on
COMPUTER_BROWSER_MODE=headed
COMPUTER_BROWSER_IDLE_MS=0

# CopilotKit Intelligence - durable threads and memory.
# Get INTELLIGENCE_API_KEY from:  npx --yes copilotkit@latest login
#                                 npx --yes copilotkit@latest project select
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=https://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=cpk-your-project-key

# The model, through OpenRouter. Every bot thinks with this key, and the bill
# lands on your OpenRouter account. Create one at https://openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
BOT_MODEL=deepseek/deepseek-v4.1-flash
AGENT_BOT_MODEL=deepseek/deepseek-v4.1-flash

# Where this deployment is reached from (used for same-origin checks)
TRUSTED_ORIGINS=https://bots.example.com,http://localhost:3010
