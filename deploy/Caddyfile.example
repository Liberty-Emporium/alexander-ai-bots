# ---------------------------------------------------------------------------
# The login gate, the Help pages and the OpenRouter key form, in front of the
# app. One site block per deployment.
#
#   <app-domain>     the app itself (password-protected here)
#   /help/           the Help pages (generated by help/build-help-pages.py)
#   /save-key        writes a new OpenRouter key into that app's .env
#   /info            reports the model and key state for the Help page
#
# Make a password hash with:   caddy hash-password --plaintext 'your-password'
# Make the shared secret with: openssl rand -hex 24
# ---------------------------------------------------------------------------

{
	auto_https off
	admin off
}

:9080 {
	basic_auth {
		YourUser $2a$14$replace-with-a-caddy-hash
	}
	handle /help {
		redir * /help/ 308
	}
	handle_path /help/* {
		root * /home/youruser/help-site/mybots
		file_server
	}
	handle /save-key {
		reverse_proxy 127.0.0.1:9090 {
			header_up X-Instance mybots
			header_up X-Save-Secret replace-with-the-shared-secret
		}
	}
	handle /info {
		reverse_proxy 127.0.0.1:9090 {
			header_up X-Instance mybots
			header_up X-Save-Secret replace-with-the-shared-secret
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}

# The Obsidian vault pages and the graph, one path per deployment.
:9083 {
	handle /mybots/* {
		basic_auth {
			YourUser $2a$14$replace-with-a-caddy-hash
		}
		uri strip_prefix /mybots
		root * /home/youruser/var/vault-site/mybots
		file_server
	}
	handle {
		redir * /mybots/ 302
	}
}
